    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "nuxt": "^3.11.2",
    "postcss": "^8.4.21",
    "prettier": "^3.9.6",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@headlessui/vue": "^1.7.12",
    "@heroicons/vue": "^2.0.17",
    "@vercel/node": "^2.10.2",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^9.13.0",
    "openai": "^5.8.2"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs,cjs}": [
